# =====================================================================
# KR MULTIMARCAS — variáveis de ambiente
# Copie este arquivo para `.env` e preencha. Nunca comite o `.env`.
# =====================================================================

# ---------------------------------------------------------------------
# FASE 1 — obrigatórias para a loja funcionar
# ---------------------------------------------------------------------

# Número de WhatsApp da loja: 55 + DDD + número (só dígitos).
# >>> TROQUE PELO NÚMERO REAL DA LOJA ANTES DE PUBLICAR <<<
NEXT_PUBLIC_STORE_WHATSAPP=5547999999999

# Nome exibido e URL pública (usada em SEO / sitemap / Open Graph)
NEXT_PUBLIC_STORE_NAME="KR Multimarcas"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Valor mínimo (em reais) para frete grátis
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=399

# Senha do painel /admin (gate simples da Fase 1; na Fase 2 vira Supabase Auth)
ADMIN_PASSWORD=troque-esta-senha

# ---------------------------------------------------------------------
# BANCO DE DADOS — Supabase (Postgres)
# Sem estas variáveis o projeto roda em MODO DEMONSTRAÇÃO (dados em memória).
# Supabase > Project Settings > Database > Connection string
# ---------------------------------------------------------------------
# Connection pooling (porta 6543) — usada pela aplicação
DATABASE_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexão direta (porta 5432) — usada pelas migrations do Prisma
DIRECT_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------
# FASE 2 — Supabase Auth + Storage (upload de imagens)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=produtos

# ---------------------------------------------------------------------
# FASE 2 — Frete (Melhor Envio)
# ---------------------------------------------------------------------
MELHORENVIO_TOKEN=
MELHORENVIO_SANDBOX=true
ORIGIN_CEP=89000000

# ---------------------------------------------------------------------
# FASE 2 — Pagamentos (Mercado Pago / Pix)
# ---------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# FASE 3 — ERP / NF-e (Bling)
# ---------------------------------------------------------------------
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_ACCESS_TOKEN=

# ---------------------------------------------------------------------
# FASE 3 — Catálogo Meta + Pixel
# ---------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=
META_CATALOG_ID=
META_ACCESS_TOKEN=
